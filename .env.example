# Crypto Trading Bot - Phase 1 Configuration

# CRITICAL SAFETY: Must be true in Phase 1. The bot will refuse to start if false.
PAPER_TRADING_ONLY=true

# Market Data Settings
TRADING_SYMBOL=BTCUSDT
CANDLE_INTERVAL=5m
MARKET_DATA_LIMIT=250

# Paper Trading Initial Balance (USD)
INITIAL_BALANCE=10000.0
MAKER_FEE=0.0002
TAKER_FEE=0.00075

# Risk Engine Thresholds
MAX_RISK_PER_TRADE=0.005    # 0.5%
MAX_DAILY_LOSS=0.02         # 2.0%
MAX_POSITION_SIZE=0.10      # 10.0% of portfolio
MAX_OPEN_POSITIONS=1
LEVERAGE=1.0

# Bot Loop Interval (seconds)
LOOP_INTERVAL_SECONDS=60

# Jev Agent Settings
USE_LIVE_JEV=false          # CRITICAL SAFETY: Must be false. If false, RuleBasedJev offline simulation is used.
JEV_AGENT_KEY=your_jev_api_key_here
JEV_ENDPOINT=https://api.typesafe.ai/v1/systemone
JEV_MODEL=jev-latest
JEV_CONFIDENCE_THRESHOLD=0.60
JEV_TIMEOUT_SECONDS=5.0
